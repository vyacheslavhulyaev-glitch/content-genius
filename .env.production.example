# Copy to .env.production on the VPS; never commit the populated file.
APP_NAME=ContentGenius
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://contentgenius.example.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

# Same public origin, with the public hostname (no scheme) in Sanctum's list.
FRONTEND_URL=https://contentgenius.example.com
SANCTUM_STATEFUL_DOMAINS=contentgenius.example.com
# Set to the shared proxy's address/subnet after inspecting the web network.
TRUSTED_PROXIES=

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=contentgenius
DB_USERNAME=contentgenius
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_COOKIE=contentgenius_session
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=sync
LOG_CHANNEL=stderr
LOG_LEVEL=warning
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MAIL_MAILER=log

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MODERATION_MODEL=gpt-4o-mini
AI_REQUESTS_PER_HOUR=5
AI_QUOTA_WINDOW_SECONDS=3600
AI_MAX_OUTPUT_TOKENS=4500
AI_MAX_ARTICLE_WORDS=1500
AI_MAX_INPUT_CHARACTERS=6000
AI_DAILY_COST_LIMIT_USD=0.10
AI_MONTHLY_COST_LIMIT_USD=1.00
AI_DAILY_PROVIDER_CALL_LIMIT=50
AI_DAILY_TOKEN_LIMIT=75000
AI_INPUT_TOKEN_RESERVATION_MARGIN=1024
AI_MODERATION_MAX_OUTPUT_TOKENS=256

# Optional dedicated demo account; configure its credentials before explicit seeding.
DEMO_EMAIL=demo@contentgenius.example
DEMO_PASSWORD=
ADMIN_DEMO_EMAIL=admin-demo@contentgenius.hideas.dev
ADMIN_DEMO_PASSWORD=
CONTENTGENIUS_IMAGE_TAG=local
